# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# Raw data. The two canonical source snapshots ARE committed (small, public,
# academic-reuse-with-attribution — see data/raw/README.md) so the repo is
# clone-and-run reproducible and survives upstream URL changes. Anything else
# dropped into data/raw/ stays ignored.
data/raw/*
!data/raw/.gitkeep
!data/raw/partos-e-cesarianas.csv
!data/raw/pordata.xlsx
!data/raw/README.md

# Pipeline artefacts (rebuildable from data/raw via run_all.R)
data/processed/*
!data/processed/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep

# Local-only working folder — never commit.
deliverables/

# Office lock files
**/~$*

# Shiny / rsconnect
rsconnect/

# Shiny bundle data — derived copy of data/processed/ + outputs/tables/headline.csv,
# rebuilt every time deploy_app.R runs. Never edit by hand and never commit.
shiny/data/

# OS
.DS_Store

# Claude Code local config (machine-specific, not project source)
.claude/settings.local.json
