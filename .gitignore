# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# Raw data — fetched at runtime by R/00_download.R; PORDATA exported manually.
# Not committed to keep the public repo free of upstream data licences.
data/raw/*
!data/raw/.gitkeep

# Pipeline artefacts (rebuildable from data/raw via run_all.R)
data/processed/*
!data/processed/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep

# Knitted paper + LaTeX intermediates
paper/paper.html
paper/paper.pdf
paper/paper.knit.md
paper/paper.utf8.md
paper/paper.aux
paper/paper.log
paper/paper.tex
paper/paper.toc
paper/paper.synctex.gz
paper/*_files/
paper/*_cache/

# Office lock files
**/~$*

# Knitted slides
presentation/slides.html
presentation/slides_files/

# Shiny / rsconnect
rsconnect/

# OS
.DS_Store

# Claude Code local config (machine-specific, not project source)
.claude/settings.local.json
