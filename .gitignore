# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# Raw data — fetched at runtime by R/00_download.R; PORDATA exported manually.
# Not committed to keep the public repo free of upstream data licences.
data/raw/*
!data/raw/.gitkeep

# Pipeline artefacts (rebuildable from data/raw via run_all.R)
data/processed/*
!data/processed/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep

# Local-only working folder — never commit.
deliverables/

# Office lock files
**/~$*

# Shiny / rsconnect
rsconnect/

# Shiny bundle data — derived copy of data/processed/ + outputs/tables/headline.csv,
# rebuilt every time deploy_app.R runs. Never edit by hand and never commit.
shiny/data/

# OS
.DS_Store

# Claude Code local config (machine-specific, not project source)
.claude/settings.local.json
