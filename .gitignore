# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# Raw data — fetched at runtime by R/00_download.R; PORDATA exported manually.
# Not committed to keep the public repo free of upstream data licences.
data/raw/*
!data/raw/.gitkeep

# Pipeline artefacts (rebuildable from data/raw via run_all.R)
data/processed/*
!data/processed/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep

# Local-only deliverables — the rendered paper (PDF) and oral-defense
# presentation (PPTX) are produced and kept locally in deliverables/
# but are NOT committed to the public repo, by project policy.
deliverables/

# Source files for the paper / slides are likewise not part of the
# public repo — if regenerated locally, keep them out of git.
paper/paper.Rmd
paper/references.bib
paper/paper.html
paper/paper.pdf
paper/*_files/
paper/*_cache/
presentation/

# Office lock files
**/~$*

# Shiny / rsconnect
rsconnect/

# Shiny bundle data — derived copy of data/processed/ + outputs/tables/headline.csv,
# rebuilt every time deploy_app.R runs. Never edit by hand and never commit.
shiny/data/

# OS
.DS_Store

# Claude Code local config (machine-specific, not project source)
.claude/settings.local.json
